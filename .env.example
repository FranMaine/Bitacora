# Conexión a la base (Neon, con pooler)
DATABASE_URL="postgresql://usuario:clave@host-pooler/neondb?sslmode=require"
# Clave para firmar la sesión: 64 caracteres hexadecimales al azar
SESSION_SECRET=""

# Recuperar contraseña por mail. Elegí UNA de las dos opciones:
# 1) Gmail (no pide dominio): cuenta de Gmail con verificación en dos pasos + "contraseña de aplicación"
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# 2) Resend (https://resend.com, pide un dominio verificado)
# RESEND_API_KEY=""
# MAIL_FROM="Bitácora CVSI <no-responder@tudominio.com>"
# Opcional: URL pública de la app para armar los links (por defecto, la de Vercel)
APP_URL=""
# Solo para probar en local: muestra el mail en la consola del servidor en vez de enviarlo
# MAIL_CONSOLA=1
